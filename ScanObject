-- ============================================
-- STATE
-- ============================================
local logCounter = 0
local logHistory = {}
local isScanning = false

-- ============================================
-- UTIL: PATH LENGKAP
-- ============================================
local function getFullPath(instance)
    local path = instance.Name
    local current = instance.Parent
    while current and current ~= game do
        path = current.Name .. "." .. path
        current = current.Parent
    end
    return path
end

-- ============================================
-- UTIL: LOG
-- ============================================
local function addLog(text)
    logCounter = logCounter + 1

    local logLabel = Instance.new("TextLabel")
    logLabel.Size = UDim2.new(1, 0, 0, 0)
    logLabel.AutomaticSize = Enum.AutomaticSize.Y
    logLabel.BackgroundTransparency = 1
    logLabel.Text = text
    logLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    logLabel.TextXAlignment = Enum.TextXAlignment.Left
    logLabel.TextYAlignment = Enum.TextYAlignment.Top
    logLabel.TextWrapped = true
    logLabel.TextSize = 11
    logLabel.Font = Enum.Font.Code
    logLabel.LayoutOrder = logCounter
    logLabel.Parent = logFrame

    table.insert(logHistory, text)

    task.wait()
    logFrame.CanvasPosition = Vector2.new(0, logFrame.AbsoluteCanvasSize.Y)
end

local function clearLog()
    for _, child in ipairs(logFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    logCounter = 0
    logHistory = {}
end

-- ============================================
-- PARSE LIMIT DARI TEXTBOX
-- ============================================
local function getLimit()
    local n = tonumber(limitBox.Text)
    if not n or n < 0 then
        return DEFAULT_LIMIT
    end
    return math.floor(n)
end

-- ============================================
-- SCAN
-- ============================================
local function scanNearbyObjects()
    if isScanning then return end
    isScanning = true

    clearLog()

    local character = player.Character
    if not character then
        addLog("ERR: karakter tidak ditemukan")
        isScanning = false
        return
    end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        addLog("ERR: HumanoidRootPart tidak ditemukan")
        isScanning = false
        return
    end

    local limit = getLimit()
    local origin = rootPart.Position

    addLog("pos: " .. tostring(origin))
    addLog("radius: " .. RADIUS .. " stud")
    addLog("limit: " .. (limit == 0 and "unlimited" or limit))
    addLog("------------------------------")

    local found = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        -- Cek limit (0 = unlimited)
        if limit > 0 and found >= limit then
            break
        end

        if obj:IsDescendantOf(character) then
            continue
        end

        if obj:IsA("BasePart") then
            local distance = (obj.Position - origin).Magnitude
            if distance <= RADIUS then
                found = found + 1
                local path = getFullPath(obj)
                addLog(string.format("[%s] %s (%.2f stud)", obj.ClassName, obj.Name, distance))
                addLog("  -> " .. path)
            end
        end
    end

    addLog("------------------------------")
    if found == 0 then
        addLog("tidak ada objek dalam radius")
    else
        addLog("total: " .. found .. " objek")
        if limit > 0 and found >= limit then
            addLog("(berhenti karena limit tercapai)")
        end
    end

    isScanning = false
end

-- ============================================
-- COPY LOGS
-- ============================================
local function copyLogs()
    local text = table.concat(logHistory, "\n")

    if setclipboard then
        pcall(setclipboard, text)
        return true
    end

    print("===== SCAN LOGS =====")
    print(text)
    print("=====================")
    return false
end

